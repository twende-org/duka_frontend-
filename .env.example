# ---------------------------------------------------------------------------
# duka_frontend — environment
# Copy to .env and fill in the values for your environment.
# In Docker the compose env_file plays the same role: the container entrypoint
# rewrites /config.js from these VITE_* vars on every start.
# ---------------------------------------------------------------------------

# Public site URL (canonical links, SEO pages, share previews)
VITE_APP_URL=https://duka.twendedigital.tech

# ---------------------------------------------------------------------------
# Django DRF backend (companion repo: twende-org/duka_backend)
# ---------------------------------------------------------------------------
#
# Base URL of the Django API, no trailing slash. Leave empty when the API is
# served from the same origin as the app (e.g. behind nginx).
# Local development: http://127.0.0.1:8009 (8000 is used by another local
# project on this machine — pick any free port and match the runserver call).
VITE_API_BASE_URL=

# Facebook / Instagram integration
#
# VITE_FACEBOOK_REDIRECT_URI is the OAuth redirect target. Leave it empty to
# derive it from VITE_API_BASE_URL, or from the page origin when the API is
# same-origin: <base>/api/v1/social/facebook/callback (Django handles the
# exchange with FACEBOOK_APP_SECRET, configured in the backend's .env).
VITE_FACEBOOK_APP_ID=
VITE_FACEBOOK_REDIRECT_URI=
VITE_FACEBOOK_ACCESS_TOKEN=

# AI features
# Still read by components that call OpenRouter straight from the browser.
# AI calls that go through the Django `ai` / `insights` domains do not use it;
# those run server-side with the backend's OPENROUTER_API_KEY.
VITE_OPENROUTER_API_KEY=

# Google Identity Services (GIS) client ID for the Django Google sign-in.
VITE_GOOGLE_CLIENT_ID=
